generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// Better Auth Core Tables
// ----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean   @map("email_verified")
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  // Devora Extended Profile Fields
  title           String?   // Headline (e.g. "Senior Fullstack Engineer")
  bio             String?
  location        String?
  timezone        String?
  githubUrl       String?
  githubUsername  String?
  onboarded       Boolean   @default(false)
  tags            String[]  // Array of tags (e.g. "UI/UX", "Frontend")
  primaryStack    String[]  // Main tools
  availabilityHrs Int?      // 5, 8, 12, 20
  workStyle       String?   // "Async-First", etc.
  projectGoal     String?   // Project goals (supports comma-separated / multiple)

  // Professional Developer Profile Fields (Phase 1)
  experienceYears Float?    // Pengalaman Web Developer dalam tahun (misal: 0.5, 1, 3, 5)
  experienceLevel String?   // "BEGINNER" | "JUNIOR" | "INTERMEDIATE" | "SENIOR"
  workPreference  String?   // "REMOTE" | "HYBRID" | "ONSITE"
  flexibleHours   Boolean   @default(true)
  availableDays   String[]  @default([]) // e.g. ["Senin", "Selasa", "Sabtu", "Minggu"]
  portfolioUrl    String?   // URL portfolio utama
  linkedinUrl     String?   // URL profil LinkedIn
  websiteUrl      String?   // URL website personal/blog

  // Relations
  sessions    Session[]
  accounts    Account[]
  
  projects    Project[] @relation("AuthoredProjects")
  
  swipesMade  Swipe[]   @relation("SwipesMade")
  swipesRcvd  Swipe[]   @relation("SwipesReceived")
  
  matches1    Match[]   @relation("User1Matches")
  matches2    Match[]   @relation("User2Matches")

  joinRequests JoinRequest[] @relation("UserJoinRequests")
  sentMessages Message[]     @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  certificates  Certificate[]
  portfolios    PortfolioProject[]

  posts         Post[]             @relation("UserPosts")
  postLikes     PostLike[]         @relation("UserPostLikes")
  comments      Comment[]          @relation("UserComments")
  commentLikes  CommentLike[]      @relation("UserCommentLikes")
  bookmarks     Bookmark[]         @relation("UserBookmarks")
  stories       Story[]            @relation("UserStories")
  storyViews    StoryView[]        @relation("UserStoryViews")

  following     Follow[]           @relation("UserFollowing")
  followers     Follow[]           @relation("UserFollowers")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ----------------------------------------------------------------------------
// Devora App Data Models
// ----------------------------------------------------------------------------

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  tags        String[]
  lookingFor  String[]
  stage       String   @default("Ideation")
  repoUrl     String?
  
  authorId    String
  author      User     @relation("AuthoredProjects", fields: [authorId], references: [id], onDelete: Cascade)
  
  roles         ProjectRole[]
  roadmap       ProjectMilestone[]
  joinRequests  JoinRequest[]
  posts         Post[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
  @@index([stage])
  @@index([createdAt])
  @@map("project")
}

model ProjectRole {
  id                  String   @id @default(cuid())
  projectId           String
  roleTitle           String
  requiredSkills      String[]
  hoursPerWeek        Int
  responsibilityLevel String   // e.g., "LEAD", "CORE_BUILDER"
  urgency             String   // e.g., "IMMEDIATE", "NEXT_SPRINT"
  description         String?

  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([projectId])
  @@map("project_role")
}

model ProjectMilestone {
  id            String   @id @default(cuid())
  projectId     String
  title         String
  description   String?
  targetQuarter String
  status        String   // "UPCOMING", "IN_PROGRESS", "COMPLETED"

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@map("project_milestone")
}

model JoinRequest {
  id            String   @id @default(cuid())
  projectId     String
  applicantId   String
  roleTitle     String
  pitchNote     String?
  status        String   @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED"

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applicant     User     @relation("UserJoinRequests", fields: [applicantId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@index([applicantId])
  @@index([status])
  @@map("join_request")
}

model Message {
  id            String   @id @default(cuid())
  senderId      String
  receiverId    String
  content       String
  read          Boolean  @default(false)
  
  sender        User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver      User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@map("message")
}

model Swipe {
  id          String   @id @default(cuid())
  swiperId    String
  swipedId    String
  direction   String   // "RIGHT" or "LEFT"
  
  createdAt   DateTime @default(now())
  
  swiper      User     @relation("SwipesMade", fields: [swiperId], references: [id], onDelete: Cascade)
  swiped      User     @relation("SwipesReceived", fields: [swipedId], references: [id], onDelete: Cascade)

  @@unique([swiperId, swipedId]) // Prevent duplicate swipes
  @@index([swiperId])
  @@index([swipedId])
  @@map("swipe")
}

model Match {
  id          String   @id @default(cuid())
  user1Id     String
  user2Id     String
  
  createdAt   DateTime @default(now())

  user1       User     @relation("User1Matches", fields: [user1Id], references: [id], onDelete: Cascade)
  user2       User     @relation("User2Matches", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@map("match")
}

model Certificate {
  id            String   @id @default(cuid())
  userId        String
  title         String   // e.g. "AWS Certified Solutions Architect"
  issuer        String   // e.g. "Amazon Web Services", "Coursera", "Dicoding"
  issueDate     String?  // e.g. "Jan 2025"
  credentialUrl String?  // Link verify or view certificate
  fileUrl       String?  // uploaded certificate image / pdf
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("certificate")
}

model PortfolioProject {
  id          String   @id @default(cuid())
  userId      String
  title       String   // e.g. "SaaS AI Code Reviewer"
  description String?
  liveUrl     String?  // e.g. "https://myproject.com"
  repoUrl     String?  // e.g. "https://github.com/..."
  tags        String[] // ["Next.js", "PostgreSQL", "Tailwind"]
  imageUrl    String?  // thumbnail screenshot
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("portfolio_project")
}

// ----------------------------------------------------------------------------
// Devora Social Media Models (Instagram for Developers)
// ----------------------------------------------------------------------------

model Post {
  id           String     @id @default(cuid())
  authorId     String
  author       User       @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)
  
  content      String     // Caption text / description
  mediaUrls    String[]   @default([]) // UI screenshot images, mockup diagrams
  codeSnippet  String?    // Formatted code snippet block
  codeLanguage String?    // "typescript" | "python" | "go" | "rust" | "sql" | "html" | "css"
  tags         String[]   @default([]) // ["#BuildInPublic", "#Showcase", "#Nextjs"]
  category     String     @default("GENERAL") // "SHOWCASE", "BUILD_IN_PUBLIC", "NEED_PARTNER", "TECH_TIPS", "GENERAL"
  
  projectId    String?
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  likes        PostLike[]
  comments     Comment[]
  bookmarks    Bookmark[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([category])
  @@map("post")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation("UserPostLikes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@index([createdAt])
  @@map("post_like")
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  authorId  String
  content   String
  parentId  String?
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  likes     CommentLike[]
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@index([createdAt])
  @@map("comment")
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation("UserCommentLikes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("comment_like")
}

model Bookmark {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation("UserBookmarks", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("bookmark")
}

model Story {
  id        String      @id @default(cuid())
  authorId  String
  author    User        @relation("UserStories", fields: [authorId], references: [id], onDelete: Cascade)
  mediaUrl  String?
  caption   String?
  views     StoryView[]
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@index([authorId])
  @@index([expiresAt])
  @@map("story")
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  viewerId  String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer    User     @relation("UserStoryViews", fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([storyId, viewerId])
  @@index([storyId])
  @@index([viewerId])
  @@map("story_view")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follow")
}
