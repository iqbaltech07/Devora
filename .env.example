# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:password@localhost:5432/devora?sslmode=require"
DIRECT_URL="postgresql://postgres:password@localhost:5432/devora"

# Better Auth Configuration
BETTER_AUTH_SECRET="your-better-auth-secret-key-32-chars-min"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Production URL for Better Auth OAuth Proxy (for preview deployments)
# BETTER_AUTH_PRODUCTION_URL="https://devora-find.vercel.app"

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# GitHub OAuth App (Optional - for GitHub Login & Sync)
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# Upstash Redis (Optional - for Presence, Realtime Chat Cache & Rate Limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
